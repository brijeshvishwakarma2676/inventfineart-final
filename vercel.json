{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "build/client",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/about-us.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/contact-us.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/gallery.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/services.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/sculptures.html",
      "destination": "/sculptures",
      "statusCode": 301
    },
    {
      "source": "/planter.html",
      "destination": "/designer-planters",
      "statusCode": 301
    },
    {
      "source": "/grc-products.html",
      "destination": "/grc-products",
      "statusCode": 301
    },
    {
      "source": "/wall_murals.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/water_fountains.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/other.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/our_client.html",
      "destination": "/",
      "statusCode": 301
    }
  ]
}
